# Часовой пояс и срок жизни кода подключения ПК (минуты)
TZ=Europe/Moscow
PAIRING_TTL=5

# Вход через провайдеров. Необязательно: есть вход по коду доступа к аккаунту.
# Адреса возврата приложение считает из самого запроса:
#   https://<домен>/signin-google  и  https://<домен>/signin-github
